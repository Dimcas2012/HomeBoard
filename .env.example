# Copy to .env and fill in values:
#   copy .env.example .env

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hosts / origins (HTTPS required for phone camera)
ALLOWED_HOSTS=localhost,127.0.0.1,10.1.10.123,homeboard.example.com
CSRF_TRUSTED_ORIGINS=https://10.1.10.123:8007,https://homeboard.example.com

# Database (MySQL by default; SQLite also works if you change ENGINE)
DB_ENGINE=django.db.backends.mysql
DB_NAME=homeboard
DB_USER=homeboard
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Channels: memory (single process) or redis (multi-worker)
CHANNEL_LAYER=memory
REDIS_URL=redis://127.0.0.1:6380/0

# MediaMTX WebRTC (WHEP) base URL for IP/RTSP cameras
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889

# Recordings retention
RECORDING_RETENTION_DAYS=14
RECORDING_MAX_GB=10

# Optional production TURN (recommended when phone and PC are on different networks)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# AI analytics (optional)
ANALYTICS_DEVICE=cpu
# ANALYTICS_YOLO_WEIGHTS=models/yolov8n.pt
# ANALYTICS_RELAY_SECRET=
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=moondream
